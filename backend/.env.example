# Copy this file to .env and fill in your values.

# Google AI Studio API key — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Postgres connection (SQLAlchemy URL). Create the db first:
#   createdb resume_toolkit
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/resume_toolkit

# --- Optional overrides (defaults shown) ---
# CHAT_MODEL=gemini-2.5-flash
# OPTIMIZER_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:3000
# ACCEPTABLE_ATS_SCORE=85
# MAX_ITERATIONS=4
# OPTIMIZER_TIMEOUT_SECONDS=300
